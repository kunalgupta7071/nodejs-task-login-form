<!DOCTYPE html>
<html>
<head>
  <title>Result</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>🎉 Thank You, <%= entry.name %>!</h1>
    <p><strong>Email:</strong> <%= entry.email %></p>
    <p><strong>Message:</strong> <%= entry.message %></p>
    <p><strong>Submitted At:</strong> <%= entry.time %></p>
    <div class="btn-group">
      <a href="/" class="link-btn">Back to Form</a>
      <a href="/submissions" class="link-btn">View Submissions</a>
    </div>
  </div>
</body>
</html>
